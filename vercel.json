{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/potluck",
      "destination": "/apps/potluck/new.html"
    },
    {
      "source": "/potluck/:slug",
      "destination": "/apps/potluck/view.html"
    },
    {
      "source": "/eat",
      "destination": "/apps/eat/new.html"
    },
    {
      "source": "/eat/:slug",
      "destination": "/apps/eat/view.html"
    }
  ]
}
