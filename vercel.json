{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/potluck",
      "destination": "/apps/potluck/new"
    },
    {
      "source": "/potluck/:slug",
      "destination": "/apps/potluck/view"
    },
    {
      "source": "/eat",
      "destination": "/apps/eat/new"
    }
  ]
}
