{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/potluck",
      "destination": "/apps/potluck/new"
    },
    {
      "source": "/potluck/:slug",
      "destination": "/api/page?app=potluck&slug=:slug"
    },
    {
      "source": "/eat",
      "destination": "/apps/eat/new"
    },
    {
      "source": "/meet",
      "destination": "/apps/meet/new"
    },
    {
      "source": "/meet/:slug",
      "destination": "/api/page?app=meet&slug=:slug"
    },
    {
      "source": "/gift",
      "destination": "/apps/gift/new"
    },
    {
      "source": "/gift/:slug",
      "destination": "/api/page?app=gift&slug=:slug"
    },
    {
      "source": "/registry",
      "destination": "/apps/registry/new"
    },
    {
      "source": "/registry/:slug",
      "destination": "/api/page?app=registry&slug=:slug"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/grams",
      "destination": "/apps/grams/new"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "public/apps/*/view.html"
    }
  },
  "headers": [
    {
      "source": "/shared/(.*)\\.(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
